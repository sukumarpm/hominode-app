<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android startup window -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#020B18</item>
        <item name="android:navigationBarColor">#020B18</item>
    </style>

    <!-- Window while Flutter initializes -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">#020B18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#020B18</item>
        <item name="android:navigationBarColor">#020B18</item>
    </style>

</resources>