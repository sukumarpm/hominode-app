rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function residentMayAccessReceipt(communityId, billId, uid) {
      let profilePath =
        /databases/(default)/documents/users/$(request.auth.uid);

      let billPath =
        /databases/(default)/documents/bills/$(billId);

      return signedIn()
        && uid == request.auth.uid

        && firestore.exists(profilePath)
        && firestore.exists(billPath)

        && firestore.get(profilePath).data.role == 'resident'
        && firestore.get(profilePath).data.approvalStatus == 'approved'
        && firestore.get(profilePath).data.isActive == true

        && (
          !('status' in firestore.get(profilePath).data)
          || firestore.get(profilePath).data.status == 'active'
        )

        && firestore.get(profilePath).data.communityId == communityId

        && firestore.get(billPath).data.communityId == communityId

        && firestore.get(profilePath).data.flatId
          == firestore.get(billPath).data.flatId;
    }

    function adminMayReadReceipt(communityId) {
      let adminPath =
        /databases/(default)/documents/admins/$(request.auth.uid);

      return signedIn()
        && firestore.exists(adminPath)

        && firestore.get(adminPath).data.role == 'admin'
        && firestore.get(adminPath).data.isActive == true

        && firestore.get(adminPath).data.authorizedCommunityIds is list
        && communityId
          in firestore.get(adminPath).data.authorizedCommunityIds;
    }

    function adminMayAccessCommunity(communityId) {
  let adminPath =
    /databases/(default)/documents/admins/$(request.auth.uid);

  return signedIn()
    && firestore.exists(adminPath)
    && firestore.get(adminPath).data.role == 'admin'
    && firestore.get(adminPath).data.isActive == true
    && firestore.get(adminPath).data.authorizedCommunityIds is list
    && communityId
      in firestore.get(adminPath).data.authorizedCommunityIds;
}

function residentMayAccessCommunity(communityId) {
  let profilePath =
    /databases/(default)/documents/users/$(request.auth.uid);

  return signedIn()
    && firestore.exists(profilePath)
    && firestore.get(profilePath).data.role == 'resident'
    && firestore.get(profilePath).data.approvalStatus == 'approved'
    && firestore.get(profilePath).data.isActive == true
    && (
      !('status' in firestore.get(profilePath).data)
      || firestore.get(profilePath).data.status == 'active'
    )
    && firestore.get(profilePath).data.communityId == communityId;
}

function adminMayManageFacilityImage(communityId, facilityId) {
  let facilityPath =
    /databases/(default)/documents/amenities/$(facilityId);

  return adminMayAccessCommunity(communityId)
    && firestore.exists(facilityPath)
    && firestore.get(facilityPath).data.communityId == communityId;
}


function adminMayManageEventImage(communityId, eventId) {
  let eventPath =
    /databases/(default)/documents/events_announcements/$(eventId);

  return adminMayAccessCommunity(communityId)
    && firestore.exists(eventPath)
    && firestore.get(eventPath).data.communityId == communityId
    && firestore.get(eventPath).data.type == 'event';
}

    // ============================================================
    // PRIVATE PAYMENT RECEIPTS
    // ============================================================

    match /payment_receipts/{communityId}/{billId}/{uid}/{fileName} {

      allow read: if
        residentMayAccessReceipt(communityId, billId, uid)
        || adminMayReadReceipt(communityId);

      allow write: if
        residentMayAccessReceipt(communityId, billId, uid)

        && request.resource != null
        && resource == null

        && request.resource.size < 10 * 1024 * 1024

        && request.resource.contentType.matches(
          'image/(jpeg|jpg|png|heic|heif)'
        );
    }

    // ============================================================
    // FACILITY IMAGES
    // ============================================================

    match /facility_images/{communityId}/{facilityId}/{fileName} {

  // Reading the image only needs community authorization.
  //
  // Admin:    admins/{uid}       -> 1 document
  // Resident: admins/{uid} miss
  //           + users/{uid}      -> at most 2 documents
  allow read: if
    adminMayAccessCommunity(communityId)
    || residentMayAccessCommunity(communityId);

  // Creating/replacing/deleting requires:
  // admins/{uid} + amenities/{facilityId} -> 2 documents.
  allow write: if
    adminMayManageFacilityImage(communityId, facilityId)
    && (
      request.resource == null
      ||
      (
        request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        )
      )
    );
}

    // ============================================================
    // EVENT IMAGES
    // ============================================================

    match /event_images/{communityId}/{eventId}/{fileName} {

      allow read: if
        adminMayAccessCommunity(communityId)
        || residentMayAccessCommunity(communityId);

      allow write: if
        adminMayAccessCommunity(communityId)
        && (
          request.resource == null
          ||
          (
            request.resource != null
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches(
              'image/(jpeg|png|webp)'
            )
          )
        );
    }

    // Everything else remains private.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}